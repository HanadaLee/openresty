+static void
+ngx_stream_lua_balancer_ssl_remove(ngx_stream_lua_balancer_ssl_cache_t *cache,
+    ngx_stream_lua_balancer_ssl_node_t *node)
+{
+    ngx_rbtree_delete(&cache->tree, &node->sn.node);
+    ngx_queue_remove(&node->queue);
+    ngx_ssl_free_session(node->session);
+    ngx_free(node);
+    cache->nelts--;
+}
+
+
+static void
+ngx_stream_lua_balancer_ssl_cleanup(void *data)
+{
+    ngx_stream_lua_balancer_ssl_cache_t  *cache = data;
+
+    ngx_queue_t                         *q;
+    ngx_stream_lua_balancer_ssl_node_t  *node;
+
+    while (!ngx_queue_empty(&cache->queue)) {
+        q = ngx_queue_last(&cache->queue);
+        node = ngx_queue_data(q, ngx_stream_lua_balancer_ssl_node_t, queue);
+        ngx_stream_lua_balancer_ssl_remove(cache, node);
+    }
+}
+
+
+static ngx_int_t
+ngx_stream_lua_balancer_ssl_init(ngx_conf_t *cf,
+    ngx_stream_lua_srv_conf_t *lscf)
+{
+    ngx_pool_cleanup_t                   *cln;
+    ngx_stream_lua_balancer_ssl_cache_t  *cache;
+
+    ngx_conf_init_uint_value(lscf->balancer.ssl_session_cache_size, 256);
+
+    if (lscf->balancer.ssl_session_cache_size == 0) {
+        return NGX_OK;
+    }
+
+    if (ngx_stream_lua_balancer_ssl_index == -1) {
+        ngx_stream_lua_balancer_ssl_index =
+            SSL_get_ex_new_index(0, NULL, NULL, NULL, NULL);
+
+        if (ngx_stream_lua_balancer_ssl_index == -1) {
+            return NGX_ERROR;
+        }
+    }
+
+    cln = ngx_pool_cleanup_add(cf->pool, sizeof(*cache));
+    if (cln == NULL) {
+        return NGX_ERROR;
+    }
+
+    cache = cln->data;
+    ngx_rbtree_init(&cache->tree, &cache->sentinel,
+                    ngx_str_rbtree_insert_value);
+    ngx_queue_init(&cache->queue);
+    cache->nelts = 0;
+    cache->max = lscf->balancer.ssl_session_cache_size;
+    cln->handler = ngx_stream_lua_balancer_ssl_cleanup;
+
+    lscf->balancer.ssl_sessions = cache;
+
+    return NGX_OK;
+}
+
+
+static void
+ngx_stream_lua_balancer_ssl_save(ngx_connection_t *c)
+{
+    ngx_queue_t                          *q;
+    ngx_ssl_session_t                    *session;
+    ngx_stream_lua_balancer_ssl_node_t   *node, *last;
+    ngx_stream_lua_balancer_ssl_peer_t   *peer;
+    ngx_stream_lua_balancer_ssl_cache_t  *cache;
+
+    peer = SSL_get_ex_data(c->ssl->connection,
+                           ngx_stream_lua_balancer_ssl_index);
+    cache = peer->cache;
+
+    /* TLS 1.3 tickets can arrive after the upstream request has finished. */
+    session = ngx_ssl_get_session(c);
+    if (session == NULL) {
+        return;
+    }
+
+    node = (ngx_stream_lua_balancer_ssl_node_t *)
+               ngx_str_rbtree_lookup(&cache->tree, &peer->key, peer->hash);
+
+    if (node) {
+        ngx_ssl_free_session(node->session);
+        ngx_queue_remove(&node->queue);
+
+    } else {
+        node = ngx_alloc(sizeof(*node) + peer->key.len, c->log);
+        if (node == NULL) {
+            ngx_ssl_free_session(session);
+            return;
+        }
+
+        if (cache->nelts == cache->max) {
+            q = ngx_queue_last(&cache->queue);
+            last = ngx_queue_data(q, ngx_stream_lua_balancer_ssl_node_t,
+                                  queue);
+            ngx_stream_lua_balancer_ssl_remove(cache, last);
+        }
+
+        node->sn.str.len = peer->key.len;
+        node->sn.str.data = (u_char *) (node + 1);
+        ngx_memcpy(node->sn.str.data, peer->key.data, peer->key.len);
+        node->sn.node.key = peer->hash;
+        ngx_rbtree_insert(&cache->tree, &node->sn.node);
+        cache->nelts++;
+    }
+
+    node->session = session;
+    ngx_queue_insert_head(&cache->queue, &node->queue);
+}
