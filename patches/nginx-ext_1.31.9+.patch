+static time_t
+ngx_resolver_valid(ngx_resolver_t *r, time_t ttl)
+{
+    if (r->valid) {
+        return ngx_time() + r->valid;
+    }
+
+    if (r->min_ttl || r->max_ttl) {
+        ttl = ngx_max(ttl, r->min_ttl);
+
+        if (r->max_ttl) {
+            ttl = ngx_min(ttl, r->max_ttl);
+        }
+    }
+
+    return ngx_time() + ttl;
+}
