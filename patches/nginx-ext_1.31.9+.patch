+static char *
+ngx_http_rewrite_if_match_bracket(ngx_str_t *value, ngx_uint_t begin,
+    ngx_uint_t last, ngx_uint_t *index)
+{
+    /*
+     * When we run into this logic, the first character
+     * of the begin must be '('
+     * which is guaranteed before calling this function.
+     *
+     * The logic is quite simple: when finding a '(', the score
+     * increases by 1 and decreases by 1 if a ')' is found. Will return
+     * if the score is zero, which means the '(' and ')' are matching.
+     */
+
+    ngx_uint_t   match_score = 1;
+    ngx_uint_t   len = 0;
+    ngx_uint_t   pos, i, value_token, next_token_closes, value_parens;
+    ngx_uint_t   extra_parens;
+    ngx_uint_t   escaped;
+    u_char      *token_item = NULL;
+    ngx_int_t    valid;
+    ngx_str_t    prev_value;
+
+    if (value == NULL || begin > last || index == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    if (value[begin].len < 1 || value[begin].data[0] != '(') {
+        return NGX_CONF_ERROR;
+    }
+
+    /* skip the first one which is a '(' */
+    len = value[begin].len - 1;
+    token_item = value[begin].data + 1;
+
+    while (begin <= last) {
+        value_token = ngx_http_rewrite_if_value_token(value, begin);
+        next_token_closes = (begin < last
+                             && value[begin + 1].len
+                             && value[begin + 1].data[0] == ')');
+        /*
+         * Quoted values containing spaces are kept as a single config token;
+         * regex/string parenthesis state is therefore tracked per token.
+         */
+        value_parens = 0;
+        escaped = 0;
+
+        while (len) {
+            pos = value[begin].len - len;
+
+            if (value_token) {
+                if (*token_item == '\\') {
+                    escaped = !escaped;
+                    len--;
+                    token_item++;
+                    continue;
+                }
+
+                if (escaped) {
+                    escaped = 0;
+                    len--;
+                    token_item++;
+                    continue;
+                }
+            }
+
+            if (*token_item == '(') {
+
+                if (value_token) {
+                    value_parens++;
+                    len--;
+                    token_item++;
+                    continue;
+                }
+
+                if (pos == 0) {
+                    /* check the previous value for validity */
+                    if (begin > 0) {
+                        prev_value = value[begin - 1];
+
+                        if ((prev_value.len == 2
+                             && (ngx_strncmp(prev_value.data, "&&", 2) == 0
+                                 || ngx_strncmp(prev_value.data, "||", 2) == 0))
+                            || (prev_value.len == 1
+                                && prev_value.data[0] == '('))
+                        {
+                            match_score++;
+                        }
+
+                    } else {
+                        match_score++;
+                    }
+
+                } else {
+                    valid = 1;
+                    for (i = 0; i < pos; i++) {
+                        if (value[begin].data[i] != '(') {
+                            valid = 0;
+                            break;
+                        }
+                    }
+
+                    if (valid) {
+                        match_score++;
+                    }
+                }
+
+            } else if (*token_item == ')') {
+
+                if (value_token) {
+                    if (value_parens) {
+                        value_parens--;
+                        len--;
+                        token_item++;
+                        continue;
+                    }
+
+                    valid = 1;
+                    for (i = pos + 1; i < value[begin].len; i++) {
+                        if (value[begin].data[i] != ')') {
+                            valid = 0;
+                            break;
+                        }
+                    }
+
+                    extra_parens = value[begin].len - pos;
+
+                    if (valid && (next_token_closes
+                                  || extra_parens > match_score))
+                    {
+                        len--;
+                        token_item++;
+                        continue;
+                    }
+                }
+
+                if (pos != value[begin].len - 1) {
+                    valid = 1;
+                    for (i = pos + 1; i < value[begin].len; i++) {
+                        if (value[begin].data[i] != ')') {
+                            valid = 0;
+                            break;
+                        }
+                    }
+
+                    if (valid) {
+                        match_score--;
+                    }
+
+                } else {
+                    match_score--;
+                }
+            }
+
+            len--;
+            token_item++;
+        }
+
+        /* find the matching */
+        if (match_score == 0) {
+            *index = begin;
+            /* the one in begin + 1 must be op */
+            return NGX_CONF_OK;
+        }
+
+        begin++;
+
+        /* try with next one */
+        if (begin > last) {
+            break;
+        }
+
+        len = value[begin].len;
+        token_item = value[begin].data;
+    }
+
+    return NGX_CONF_ERROR;
+}
+
+
+static char *
+ngx_http_rewrite_parse_if_condition(ngx_conf_t *cf,
+    ngx_http_rewrite_loc_conf_t *lcf, ngx_str_t *value,
+    ngx_uint_t begin, ngx_uint_t last, ngx_uint_t depth)
+{
+    char                            *rv;
+    ngx_uint_t                       slots;
+    ngx_http_rewrite_if_op_t         op;
+    ngx_http_script_if_op_code_t    *op_code;
+
+    if (begin > last || last >= cf->args->nelts || value[begin].len == 0) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0, "empty if condition");
+        return NGX_CONF_ERROR;
+    }
+
+    rv = ngx_http_rewrite_find_if_logic_op(value, begin, last, &op);
+    if (rv != NGX_CONF_OK) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "invalid if condition at position %ui", begin);
+        return rv;
+    }
+
+    if (op.type != ngx_http_script_if_invalid) {
+        rv = ngx_http_rewrite_parse_if_condition(cf, lcf, value, begin,
+                                                 op.index - 1, depth);
+        if (rv != NGX_CONF_OK) {
+            return rv;
+        }
+
+        /* The left result remains on the stack while evaluating the right. */
+
+        rv = ngx_http_rewrite_parse_if_condition(cf, lcf, value, op.index + 1,
+                                                 last, depth + 1);
+        if (rv != NGX_CONF_OK) {
+            return rv;
+        }
+
+        op_code = ngx_array_push_n(lcf->codes,
+                                   sizeof(ngx_http_script_if_op_code_t));
+        if (op_code == NULL) {
+            return NGX_CONF_ERROR;
+        }
+
+        op_code->code = ngx_http_script_if_op_code;
+        op_code->op = op.type;
+
+        return NGX_CONF_OK;
+    }
+
+    if (value[begin].data[0] == '(') {
+        /* The matching bracket encloses the entire remaining expression. */
+
+        if (value[begin].len == 1) {
+            begin++;
+
+        } else {
+            value[begin].len--;
+            value[begin].data++;
+        }
+
+        if (value[last].len == 1) {
+            last--;
+
+        } else {
+            value[last].len--;
+            value[last].data[value[last].len] = '\0';
+        }
+
+        return ngx_http_rewrite_parse_if_condition(cf, lcf, value, begin, last,
+                                                   depth);
+    }
+
+    /* Variable comparisons may push both operands before reducing to one. */
+
+    slots = (value[begin].data[0] == '$' && begin != last) ? 2 : 1;
+    lcf->stack_size = ngx_max(lcf->stack_size, depth + slots);
+
+    return ngx_http_rewrite_if_logic_item(cf, lcf, begin, last);
+}
