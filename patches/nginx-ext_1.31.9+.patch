diff --git a/src/core/ngx_client.c b/src/core/ngx_client.c
new file mode 100644
index 0000000..6c44069
--- /dev/null
+++ b/src/core/ngx_client.c
@@ -0,0 +1,129 @@
+
+/*
+ * Copyright (C) Hanada
+ */
+
+
+#include <ngx_config.h>
+#include <ngx_core.h>
+
+
+#if (NGX_EXT && NGX_CLIENT)
+
+
+ngx_int_t ngx_http_client_create_request(ngx_cycle_t *cycle, ngx_log_t *log,
+    ngx_client_http_request_t *request, ngx_client_http_t **pclient,
+    ngx_client_http_post_request_t *post,
+    const ngx_client_http_stream_t *stream);
+ngx_int_t ngx_http_client_get_response_headers(ngx_client_http_t *client,
+    ngx_client_http_response_t **response);
+ssize_t ngx_http_client_read_response_body(ngx_client_http_t *client,
+    u_char *buf, size_t size);
+ssize_t ngx_http_client_write_request_body(ngx_client_http_t *client,
+    const u_char *buf, size_t size);
+void ngx_http_client_close_request(ngx_client_http_t *client);
+
+ngx_client_http_server_t *ngx_http_client_add_server_reference(
+    ngx_cycle_t *cycle, const ngx_str_t *name);
+ngx_int_t ngx_http_client_require(ngx_cycle_t *cycle);
+
+static char *ngx_client_http_set_server(ngx_conf_t *cf, void *post,
+    void *conf);
+
+
+ngx_conf_post_t  ngx_client_http_server_post = { ngx_client_http_set_server };
+
+
+ngx_int_t
+ngx_client_http_create_request(ngx_cycle_t *cycle, ngx_log_t *log,
+    ngx_client_http_request_t *request, ngx_client_http_t **pclient,
+    ngx_client_http_post_request_t *post)
+{
+    return ngx_http_client_create_request(cycle, log, request, pclient, post,
+                                          NULL);
+}
+
+
+ngx_int_t
+ngx_client_http_create_streaming_request(ngx_cycle_t *cycle, ngx_log_t *log,
+    ngx_client_http_request_t *request, ngx_client_http_t **pclient,
+    ngx_client_http_stream_t *stream)
+{
+    ngx_client_http_post_request_t  post;
+
+    if (stream->notify == NULL
+        || (stream->request_body_streaming && request->body.len))
+    {
+        return NGX_ERROR;
+    }
+
+    ngx_memzero(&post, sizeof(ngx_client_http_post_request_t));
+    post.check_size = stream->check_size;
+    post.data = stream->data;
+
+    return ngx_http_client_create_request(cycle, log, request, pclient, &post,
+                                          stream);
+}
+
+
+ngx_int_t
+ngx_client_http_get_response_headers(ngx_client_http_t *client,
+    ngx_client_http_response_t **response)
+{
+    return ngx_http_client_get_response_headers(client, response);
+}
+
+
+ssize_t
+ngx_client_http_read_response_body(ngx_client_http_t *client, u_char *buf,
+    size_t size)
+{
+    return ngx_http_client_read_response_body(client, buf, size);
+}
+
+
+ssize_t
+ngx_client_http_write_request_body(ngx_client_http_t *client, const u_char *buf,
+    size_t size)
+{
+    return ngx_http_client_write_request_body(client, buf, size);
+}
+
+
+void
+ngx_client_http_close_request(ngx_client_http_t *client)
+{
+    ngx_http_client_close_request(client);
+}
+
+
+ngx_int_t
+ngx_client_http_require(ngx_cycle_t *cycle)
+{
+    return ngx_http_client_require(cycle);
+}
+
+
+static char *
+ngx_client_http_set_server(ngx_conf_t *cf, void *post, void *conf)
+{
+    ngx_client_http_server_t  **slot = conf;
+
+    ngx_str_t  *value;
+
+    if (*slot) {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+
+    *slot = ngx_http_client_add_server_reference(cf->cycle, &value[1]);
+    if (*slot == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    return NGX_CONF_OK;
+}
+
+
+#endif
diff --git a/src/core/ngx_client.h b/src/core/ngx_client.h
new file mode 100644
index 0000000..5b2f381
--- /dev/null
+++ b/src/core/ngx_client.h
@@ -0,0 +1,111 @@
+
+/*
+ * Copyright (C) Hanada
+ */
+
+
+#ifndef _NGX_CLIENT_H_INCLUDED_
+#define _NGX_CLIENT_H_INCLUDED_
+
+
+#if (NGX_EXT && NGX_CLIENT)
+
+
+#define NGX_CLIENT_HTTP_TIMEDOUT   -1000
+#define NGX_CLIENT_HTTP_TOO_LARGE  -1001
+
+
+typedef struct {
+    ngx_client_http_server_t        *server;
+    const ngx_str_t                 *server_name;
+    ngx_str_t                        method;
+    ngx_str_t                        url;
+    ngx_array_t                     *headers;
+    ngx_str_t                        body;
+    ngx_msec_t                       timeout;
+} ngx_client_http_request_t;
+
+
+typedef struct {
+    ngx_uint_t                       status;
+    ngx_array_t                      headers;
+    ngx_str_t                        body;
+} ngx_client_http_response_t;
+
+
+/* The response is valid until the completion handler returns. */
+typedef void (*ngx_client_http_post_request_pt)(
+    ngx_client_http_response_t *response, void *data, ngx_int_t rc);
+
+
+/* A non-NGX_OK result rejects the prospective sizes and ends the request. */
+typedef ngx_int_t (*ngx_client_http_check_size_pt)(void *data,
+    size_t header_size, uint64_t body_size);
+
+
+/* NGX_DONE finishes the request with the headers received so far. */
+typedef ngx_int_t (*ngx_client_http_header_pt)(
+    ngx_client_http_response_t *response, void *data);
+
+
+/*
+ * Called synchronously for each non-empty body buffer. The buffer is valid
+ * only during the call. Return NGX_OK to continue or an error to stop.
+ * With this handler, the completion response has an empty body.
+ */
+typedef ngx_int_t (*ngx_client_http_body_pt)(const u_char *buf, size_t len,
+    void *data);
+
+
+typedef struct {
+    ngx_client_http_post_request_pt  handler;
+    ngx_client_http_header_pt        header_handler;
+    ngx_client_http_body_pt          body_handler;
+    ngx_client_http_check_size_pt    check_size;
+    void                            *data;
+} ngx_client_http_post_request_t;
+
+
+typedef struct {
+    ngx_event_t                     *notify;
+    ngx_client_http_check_size_pt    check_size;
+    void                            *data;
+
+    unsigned                         request_body_streaming:1;
+} ngx_client_http_stream_t;
+
+
+/*
+ * The request URL must be absolute. The default server is @client.
+ * NGX_DECLINED indicates an unknown server name. Completion is deferred.
+ */
+ngx_int_t ngx_client_http_create_request(ngx_cycle_t *cycle, ngx_log_t *log,
+    ngx_client_http_request_t *request, ngx_client_http_t **pclient,
+    ngx_client_http_post_request_t *post);
+
+/*
+ * The caller owns the stream until close, including after EOF.  Notifications
+ * are posted when an operation can be retried.  A zero-length write ends the
+ * request body.  A read returning zero marks the end of the response body.
+ */
+ngx_int_t ngx_client_http_create_streaming_request(ngx_cycle_t *cycle,
+    ngx_log_t *log, ngx_client_http_request_t *request,
+    ngx_client_http_t **pclient, ngx_client_http_stream_t *stream);
+ngx_int_t ngx_client_http_get_response_headers(ngx_client_http_t *client,
+    ngx_client_http_response_t **response);
+ssize_t ngx_client_http_read_response_body(ngx_client_http_t *client,
+    u_char *buf, size_t size);
+ssize_t ngx_client_http_write_request_body(ngx_client_http_t *client,
+    const u_char *buf, size_t size);
+
+/* Closing from a response or size callback stops delivery on return. */
+void ngx_client_http_close_request(ngx_client_http_t *client);
+
+ngx_int_t ngx_client_http_require(ngx_cycle_t *cycle);
+
+
+extern ngx_conf_post_t  ngx_client_http_server_post;
+
+#endif
+
+#endif /* _NGX_CLIENT_H_INCLUDED_ */
diff --git a/src/core/ngx_conf_file.c b/src/core/ngx_conf_file.c
index bc902d2..9e026e4 100644
--- a/src/core/ngx_conf_file.c
+++ b/src/core/ngx_conf_file.c
@@ -358,6 +358,50 @@ done:
 }
 
 
+#if (NGX_EXT && NGX_CLIENT)
+
+char *
+ngx_conf_parse_chunk(ngx_conf_t *cf, ngx_str_t *name, ngx_str_t *chunk)
+{
+    char             *rv;
+    ngx_buf_t         buf;
+    ngx_conf_t        pcf;
+    ngx_array_t      *args;
+    ngx_conf_file_t   file;
+
+    args = ngx_array_create(cf->pool, 8, sizeof(ngx_str_t));
+    if (args == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&buf, sizeof(ngx_buf_t));
+    ngx_memzero(&file, sizeof(ngx_conf_file_t));
+
+    buf.start = chunk->data;
+    buf.pos = buf.start;
+    buf.last = buf.start + chunk->len;
+    buf.end = buf.last;
+
+    /* A valid descriptor selects block parsing for the buffered text. */
+    file.file.fd = ngx_stderr;
+    file.file.name = *name;
+    file.buffer = &buf;
+    file.line = 1;
+
+    pcf = *cf;
+    cf->args = args;
+    cf->conf_file = &file;
+
+    rv = ngx_conf_parse(cf, NULL);
+
+    *cf = pcf;
+
+    return rv;
+}
+
+#endif
+
+
 static ngx_int_t
 ngx_conf_handler(ngx_conf_t *cf, ngx_int_t last)
 {
@@ -1095,6 +1139,30 @@ ngx_conf_set_str_slot(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 }
 
 
+#if (NGX_EXT && NGX_CLIENT)
+
+char *
+ngx_conf_set_client_slot(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    char  *p = conf;
+
+    ngx_str_t        *value;
+    ngx_conf_post_t  *post;
+
+    value = cf->args->elts;
+
+    if (value[1].len < 2 || value[1].data[0] != '@') {
+        return "requires a client server name starting with \"@\"";
+    }
+
+    post = cmd->post;
+
+    return post->post_handler(cf, post, p + cmd->offset);
+}
+
+#endif
+
+
 char *
 ngx_conf_set_str_array_slot(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
 {
