+
+typedef struct ngx_http_range_filter_s  ngx_http_range_filter_t;
+
+typedef ngx_int_t (*ngx_http_range_filter_pt)(ngx_http_request_t *r,
+    ngx_chain_t *in, ngx_http_range_filter_t *filter,
