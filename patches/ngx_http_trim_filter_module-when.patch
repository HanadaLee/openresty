Use literal on/off flags and expr/when conditions with NGX_RESTY_EXT.
Based on alibaba/tengine f9c9f759c029dec42ad855141fa7f0c24e9a671e.
Without NGX_RESTY_EXT or NGX_EXPR, keep the original complex-value behavior.

diff --git a/ngx_http_trim_filter_module.c b/ngx_http_trim_filter_module.c
index 494b04e..cddb9fe 100644
--- a/ngx_http_trim_filter_module.c
+++ b/ngx_http_trim_filter_module.c
@@ -8,6 +8,10 @@
 #include <ngx_core.h>
 #include <ngx_http.h>
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+#include <ngx_http_expr_module.h>
+#endif
+
 
 #define NGX_HTTP_TRIM_FLAG      "http_trim"
 
@@ -26,9 +30,15 @@ typedef struct {
     ngx_hash_t                   types;
     ngx_array_t                 *types_keys;
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+    ngx_array_t                 *js;
+    ngx_array_t                 *css;
+    ngx_array_t                 *trim;
+#else
     ngx_http_complex_value_t    *js;
     ngx_http_complex_value_t    *css;
     ngx_http_complex_value_t    *trim;
+#endif
 } ngx_http_trim_loc_conf_t;
 
 
@@ -180,22 +190,43 @@ static ngx_int_t ngx_http_trim_filter_init(ngx_conf_t *cf);
 static ngx_command_t  ngx_http_trim_commands[] = {
 
     { ngx_string("trim"),
+#if (NGX_RESTY_EXT && NGX_EXPR)
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF
+      |NGX_HTTP_MAIN_WHEN_CONF|NGX_HTTP_SRV_WHEN_CONF|NGX_HTTP_LOC_WHEN_CONF
+      |NGX_CONF_FLAG,
+      ngx_conf_set_conditional_flag_slot,
+#else
       NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_TAKE1,
       ngx_http_set_complex_value_slot,
+#endif
       NGX_HTTP_LOC_CONF_OFFSET,
       offsetof(ngx_http_trim_loc_conf_t, trim),
       NULL },
 
     { ngx_string("trim_js"),
+#if (NGX_RESTY_EXT && NGX_EXPR)
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF
+      |NGX_HTTP_MAIN_WHEN_CONF|NGX_HTTP_SRV_WHEN_CONF|NGX_HTTP_LOC_WHEN_CONF
+      |NGX_CONF_FLAG,
+      ngx_conf_set_conditional_flag_slot,
+#else
       NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_TAKE1,
       ngx_http_set_complex_value_slot,
+#endif
       NGX_HTTP_LOC_CONF_OFFSET,
       offsetof(ngx_http_trim_loc_conf_t, js),
       NULL },
 
     { ngx_string("trim_css"),
+#if (NGX_RESTY_EXT && NGX_EXPR)
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF
+      |NGX_HTTP_MAIN_WHEN_CONF|NGX_HTTP_SRV_WHEN_CONF|NGX_HTTP_LOC_WHEN_CONF
+      |NGX_CONF_FLAG,
+      ngx_conf_set_conditional_flag_slot,
+#else
       NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_TAKE1,
       ngx_http_set_complex_value_slot,
+#endif
       NGX_HTTP_LOC_CONF_OFFSET,
       offsetof(ngx_http_trim_loc_conf_t, css),
       NULL },
@@ -282,7 +313,11 @@ ngx_http_trim_header_filter(ngx_http_request_t *r)
 
     conf = ngx_http_get_module_loc_conf(r, ngx_http_trim_filter_module);
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+    if (ngx_http_get_expr_flag_value(r, conf->trim) != 1
+#else
     if (!conf->trim
+#endif
         || r->headers_out.status != NGX_HTTP_OK
         || (r->method & NGX_HTTP_HEAD)
         || r->headers_out.content_length_n == 0
@@ -303,6 +338,7 @@ ngx_http_trim_header_filter(ngx_http_request_t *r)
         return ngx_http_next_header_filter(r);
     }
 
+#if !(NGX_RESTY_EXT && NGX_EXPR)
     if (ngx_http_complex_value(r, conf->trim, &flag) != NGX_OK) {
         return NGX_ERROR;
     }
@@ -312,12 +348,17 @@ ngx_http_trim_header_filter(ngx_http_request_t *r)
     {
         return ngx_http_next_header_filter(r);
     }
+#endif
 
     ctx = ngx_pcalloc(r->pool, sizeof(ngx_http_trim_ctx_t));
     if (ctx == NULL) {
         return NGX_ERROR;
     }
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+    ctx->js_enable = (ngx_http_get_expr_flag_value(r, conf->js) == 1);
+    ctx->css_enable = (ngx_http_get_expr_flag_value(r, conf->css) == 1);
+#else
     if (conf->js) {
         if (ngx_http_complex_value(r, conf->js, &flag) != NGX_OK) {
             return NGX_ERROR;
@@ -341,6 +382,7 @@ ngx_http_trim_header_filter(ngx_http_request_t *r)
             ctx->css_enable = 1;
         }
     }
+#endif
 
     ctx->prev = ' ';
 
@@ -2092,6 +2134,12 @@ ngx_http_trim_create_loc_conf(ngx_conf_t *cf)
      *     conf->css = NULL;
      */
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+    conf->trim = NGX_CONF_UNSET_PTR;
+    conf->js = NGX_CONF_UNSET_PTR;
+    conf->css = NGX_CONF_UNSET_PTR;
+#endif
+
     return conf;
 }
 
@@ -2110,6 +2158,14 @@ ngx_http_trim_merge_loc_conf(ngx_conf_t *cf, void *parent, void *child)
         return NGX_CONF_ERROR;
     }
 
+#if (NGX_RESTY_EXT && NGX_EXPR)
+    if (ngx_conf_merge_expr_flag_value(cf, &conf->trim, prev->trim, 0) != NGX_OK
+        || ngx_conf_merge_expr_flag_value(cf, &conf->js, prev->js, 0) != NGX_OK
+        || ngx_conf_merge_expr_flag_value(cf, &conf->css, prev->css, 0) != NGX_OK)
+    {
+        return NGX_CONF_ERROR;
+    }
+#else
     if (conf->trim == NULL) {
         conf->trim = prev->trim;
     }
@@ -2121,6 +2177,7 @@ ngx_http_trim_merge_loc_conf(ngx_conf_t *cf, void *parent, void *child)
     if (conf->css == NULL) {
         conf->css = prev->css;
     }
+#endif
 
     return NGX_CONF_OK;
 }
