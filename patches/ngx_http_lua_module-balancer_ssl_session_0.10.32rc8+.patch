+static void
+ngx_http_lua_balancer_ssl_restore(ngx_peer_connection_t *pc,
+    ngx_http_lua_balancer_ssl_cache_t *cache, void *conf, ngx_str_t *name,
+    ngx_str_t *alpn)
+{
+    u_char                            *p;
+    size_t                             len;
+    SSL_CTX                           *ctx;
+    const char                        *sni;
+    ngx_uint_t                         i;
+    ngx_str_t                          parts[5];
+    ngx_connection_t                  *c;
+    ngx_ssl_session_t                 *session;
+    ngx_http_lua_balancer_ssl_node_t  *node;
+    ngx_http_lua_balancer_ssl_peer_t  *peer;
+
+    c = pc->connection;
+
+    /* A client certificate can change between connections or be reloaded. */
+    if (SSL_get_certificate(c->ssl->connection) != NULL) {
+        return;
+    }
+
+    ctx = SSL_get_SSL_CTX(c->ssl->connection);
+    sni = SSL_get_servername(c->ssl->connection, TLSEXT_NAMETYPE_host_name);
+
+    parts[0].len = pc->socklen;
+    parts[0].data = (u_char *) pc->sockaddr;
+    parts[1].len = pc->local ? pc->local->socklen : 0;
+    parts[1].data = pc->local ? (u_char *) pc->local->sockaddr : NULL;
+    parts[2].len = sni ? ngx_strlen(sni) : 0;
+    parts[2].data = (u_char *) sni;
+    parts[3] = *name;
+    parts[4] = *alpn;
+
+    len = sizeof(ctx) + sizeof(conf);
+    for (i = 0; i < sizeof(parts) / sizeof(ngx_str_t); i++) {
+        len += sizeof(size_t) + parts[i].len;
+    }
+
+    peer = ngx_palloc(c->pool, sizeof(*peer) + len);
+    if (peer == NULL) {
+        return;
+    }
+
+    peer->cache = cache;
+    peer->key.len = len;
+    peer->key.data = (u_char *) (peer + 1);
+    p = ngx_cpymem(peer->key.data, &ctx, sizeof(ctx));
+    p = ngx_cpymem(p, &conf, sizeof(conf));
+
+    for (i = 0; i < sizeof(parts) / sizeof(ngx_str_t); i++) {
+        p = ngx_cpymem(p, &parts[i].len, sizeof(size_t));
+        if (parts[i].len) {
+            p = ngx_cpymem(p, parts[i].data, parts[i].len);
+        }
+    }
+
+    if (SSL_set_ex_data(c->ssl->connection, ngx_http_lua_balancer_ssl_index,
+                        peer)
+        == 0)
+    {
+        return;
+    }
+
+    c->ssl->save_session = ngx_http_lua_balancer_ssl_save;
+    peer->hash = ngx_crc32_long(peer->key.data, len);
+    node = (ngx_http_lua_balancer_ssl_node_t *)
+               ngx_str_rbtree_lookup(&cache->tree, &peer->key, peer->hash);
+    if (node == NULL) {
+        return;
+    }
+
+    session = node->session;
+    if (ngx_time() - SSL_SESSION_get_time(session)
+        >= SSL_SESSION_get_timeout(session))
+    {
+        ngx_http_lua_balancer_ssl_remove(cache, node);
+        return;
+    }
+
+    if (ngx_ssl_set_session(c, session) != NGX_OK) {
+        ngx_http_lua_balancer_ssl_remove(cache, node);
+        return;
+    }
+
+#ifdef TLS1_3_VERSION
+    /* Offer each TLS 1.3 ticket only once. */
+    if (SSL_SESSION_get_protocol_version(session) == TLS1_3_VERSION) {
+        ngx_http_lua_balancer_ssl_remove(cache, node);
+        return;
+    }
+#endif
+
+    ngx_queue_remove(&node->queue);
+    ngx_queue_insert_head(&cache->queue, &node->queue);
+}
