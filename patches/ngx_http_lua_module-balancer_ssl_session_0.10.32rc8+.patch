+static void
+ngx_http_lua_balancer_ssl_remove(ngx_http_lua_balancer_ssl_cache_t *cache,
+    ngx_http_lua_balancer_ssl_node_t *node)
+{
+    ngx_rbtree_delete(&cache->tree, &node->sn.node);
+    ngx_queue_remove(&node->queue);
+    ngx_ssl_free_session(node->session);
+    ngx_free(node);
+    cache->nelts--;
+}
+
+
+static void
+ngx_http_lua_balancer_ssl_cleanup(void *data)
+{
+    ngx_http_lua_balancer_ssl_cache_t  *cache = data;
+
+    ngx_queue_t                       *q;
+    ngx_http_lua_balancer_ssl_node_t  *node;
+
+    while (!ngx_queue_empty(&cache->queue)) {
+        q = ngx_queue_last(&cache->queue);
+        node = ngx_queue_data(q, ngx_http_lua_balancer_ssl_node_t, queue);
+        ngx_http_lua_balancer_ssl_remove(cache, node);
+    }
+}
