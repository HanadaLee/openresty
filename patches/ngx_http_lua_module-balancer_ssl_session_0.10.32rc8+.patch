+static void
+ngx_lua_balancer_ssl_remove(ngx_lua_balancer_ssl_cache_t *cache,
+    ngx_lua_balancer_ssl_node_t *node)
+{
+    ngx_rbtree_delete(&cache->tree, &node->sn.node);
+    ngx_queue_remove(&node->queue);
+    ngx_ssl_free_session(node->session);
+    ngx_free(node);
+    cache->nelts--;
+}
+
+
+static void
+ngx_lua_balancer_ssl_cleanup(void *data)
+{
+    ngx_lua_balancer_ssl_cache_t  *cache = data;
+
+    ngx_queue_t                  *q;
+    ngx_lua_balancer_ssl_node_t  *node;
+
+    while (!ngx_queue_empty(&cache->queue)) {
+        q = ngx_queue_last(&cache->queue);
+        node = ngx_queue_data(q, ngx_lua_balancer_ssl_node_t, queue);
+        ngx_lua_balancer_ssl_remove(cache, node);
+    }
+}
+
+
+static ngx_lua_balancer_ssl_cache_t *
+ngx_lua_balancer_ssl_init(ngx_conf_t *cf)
+{
+    ngx_pool_cleanup_t            *cln;
+    ngx_lua_balancer_ssl_cache_t  *cache;
+
+    if (ngx_lua_balancer_ssl_index == -1) {
+        ngx_lua_balancer_ssl_index = SSL_get_ex_new_index(0, NULL, NULL, NULL,
+                                                         NULL);
+        if (ngx_lua_balancer_ssl_index == -1) {
+            return NULL;
+        }
+    }
+
+    cln = ngx_pool_cleanup_add(cf->pool, sizeof(ngx_lua_balancer_ssl_cache_t));
+    if (cln == NULL) {
+        return NULL;
+    }
+
+    cache = cln->data;
+    ngx_rbtree_init(&cache->tree, &cache->sentinel,
+                    ngx_str_rbtree_insert_value);
+    ngx_queue_init(&cache->queue);
+    cache->nelts = 0;
+    cln->handler = ngx_lua_balancer_ssl_cleanup;
+
+    return cache;
+}
+
+
+static void
+ngx_lua_balancer_ssl_save(ngx_connection_t *c)
+{
+    ngx_queue_t                   *q;
+    ngx_ssl_session_t             *session;
+    ngx_lua_balancer_ssl_node_t   *node, *last;
+    ngx_lua_balancer_ssl_peer_t   *peer;
+    ngx_lua_balancer_ssl_cache_t  *cache;
+
+    peer = SSL_get_ex_data(c->ssl->connection, ngx_lua_balancer_ssl_index);
+    cache = peer->cache;
+
+    /* TLS 1.3 tickets can arrive after the upstream request has finished. */
+    session = ngx_ssl_get_session(c);
+    if (session == NULL) {
+        return;
+    }
+
+    node = (ngx_lua_balancer_ssl_node_t *)
+               ngx_str_rbtree_lookup(&cache->tree, &peer->key, peer->hash);
+
+    if (node) {
+        ngx_ssl_free_session(node->session);
+        ngx_queue_remove(&node->queue);
+
+    } else {
+        node = ngx_alloc(sizeof(ngx_lua_balancer_ssl_node_t) + peer->key.len,
+                         c->log);
+        if (node == NULL) {
+            ngx_ssl_free_session(session);
+            return;
+        }
+
+        if (cache->nelts == NGX_LUA_BALANCER_SSL_CACHE_SIZE) {
+            q = ngx_queue_last(&cache->queue);
+            last = ngx_queue_data(q, ngx_lua_balancer_ssl_node_t, queue);
+            ngx_lua_balancer_ssl_remove(cache, last);
+        }
+
+        node->sn.str.len = peer->key.len;
+        node->sn.str.data = (u_char *) (node + 1);
+        ngx_memcpy(node->sn.str.data, peer->key.data, peer->key.len);
+        node->sn.node.key = peer->hash;
+        ngx_rbtree_insert(&cache->tree, &node->sn.node);
+        cache->nelts++;
+    }
+
+    node->session = session;
+    ngx_queue_insert_head(&cache->queue, &node->queue);
+}
+
