diff --git a/src/ngx_stream_lua_http_client.c b/src/ngx_stream_lua_http_client.c
new file mode 100644
index 0000000..38e2ee8
--- /dev/null
+++ b/src/ngx_stream_lua_http_client.c
@@ -0,0 +1,555 @@
+
+/*
+ * Copyright (C) Hanada
+ */
+
+
+#include "ngx_stream_lua_util.h"
+
+#if (NGX_EXT && NGX_CLIENT)
+
+
+typedef struct {
+    ngx_str_t                            server;
+    ngx_str_t                            url;
+    ngx_str_t                            method;
+    ngx_str_t                            body;
+    ngx_keyval_t                        *headers;
+    size_t                               nheaders;
+    size_t                               response_limit;
+    int                                  stream;
+    int                                  request_body_streaming;
+} ngx_stream_lua_http_client_request_t;
+
+
+typedef struct {
+    ngx_str_t                            body;
+    ngx_keyval_t                        *headers;
+    size_t                               nheaders;
+    unsigned                             status;
+    const char                          *error;
+} ngx_stream_lua_http_client_result_t;
+
+
+typedef struct {
+    ngx_stream_lua_http_client_result_t  result;
+    ngx_client_http_t                   *client;
+    ngx_stream_lua_request_t            *request;
+    ngx_stream_lua_co_ctx_t             *coctx;
+    size_t                               response_limit;
+} ngx_stream_lua_http_client_ctx_t;
+
+
+typedef struct {
+    ngx_stream_lua_http_client_ctx_t     ctx;
+    ngx_event_t                          event;
+    ngx_stream_lua_cleanup_t            *cleanup;
+} ngx_stream_lua_http_client_stream_t;
+
+
+int ngx_stream_lua_ffi_http_client(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_request_t *request,
+    ngx_stream_lua_http_client_result_t **result, u_char *err, size_t *errlen);
+void ngx_stream_lua_ffi_http_client_done(
+    ngx_stream_lua_http_client_result_t *result);
+
+int ngx_stream_lua_ffi_http_client_get_response_headers(
+    ngx_stream_lua_request_t *r, ngx_stream_lua_http_client_result_t *result);
+ssize_t ngx_stream_lua_ffi_http_client_read_response_body(
+    ngx_stream_lua_request_t *r, ngx_stream_lua_http_client_result_t *result,
+    u_char *buf, size_t size);
+ssize_t ngx_stream_lua_ffi_http_client_write_request_body(
+    ngx_stream_lua_request_t *r, ngx_stream_lua_http_client_result_t *result,
+    const u_char *buf, size_t size);
+int ngx_stream_lua_ffi_http_client_wait(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_result_t *result, u_char *err, size_t *errlen);
+void ngx_stream_lua_ffi_http_client_close(
+    ngx_stream_lua_http_client_result_t *result);
+void ngx_stream_lua_ffi_http_client_release(
+    ngx_stream_lua_http_client_result_t *result);
+
+static ngx_stream_lua_ctx_t *ngx_stream_lua_http_client_context(
+    ngx_stream_lua_request_t *r, u_char *err, size_t *errlen);
+static void ngx_stream_lua_http_client_notify(ngx_event_t *ev);
+static void ngx_stream_lua_http_client_stream_cleanup(void *data);
+static void ngx_stream_lua_http_client_wait_cleanup(void *data);
+static void ngx_stream_lua_http_client_cancel(void *data);
+static void ngx_stream_lua_http_client_handler(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_co_ctx_t *coctx);
+static ngx_int_t ngx_stream_lua_http_client_resume(ngx_stream_lua_request_t *r);
+static ngx_int_t ngx_stream_lua_http_client_check_size(void *data,
+    size_t header_size, uint64_t body_size);
+static void ngx_stream_lua_http_client_complete(
+    ngx_client_http_response_t *response, void *data, ngx_int_t rc);
+
+
+static ngx_stream_lua_ctx_t *
+ngx_stream_lua_http_client_context(ngx_stream_lua_request_t *r, u_char *err,
+    size_t *errlen)
+{
+    unsigned               flags;
+    ngx_stream_lua_ctx_t  *lctx;
+
+    lctx = ngx_stream_lua_get_module_ctx(r, ngx_stream_lua_module);
+    if (lctx == NULL || lctx->cur_co_ctx == NULL) {
+        *errlen = ngx_snprintf(err, *errlen, "no coroutine context") - err;
+        return NULL;
+    }
+
+    flags = NGX_STREAM_LUA_CONTEXT_PREREAD
+            | NGX_STREAM_LUA_CONTEXT_CONTENT
+            | NGX_STREAM_LUA_CONTEXT_TIMER;
+
+#ifdef NGX_STREAM_LUA_CONTEXT_ACCESS
+    flags |= NGX_STREAM_LUA_CONTEXT_ACCESS;
+#endif
+
+    if (ngx_stream_lua_ffi_check_context(lctx, flags, err, errlen) != NGX_OK) {
+        return NULL;
+    }
+
+    return lctx;
+}
+
+
+int
+ngx_stream_lua_ffi_http_client(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_request_t *request,
+    ngx_stream_lua_http_client_result_t **result, u_char *err, size_t *errlen)
+{
+    ngx_int_t                             rc;
+    ngx_array_t                           headers;
+    ngx_stream_lua_ctx_t                 *lctx;
+    ngx_stream_lua_co_ctx_t              *coctx;
+    ngx_client_http_stream_t              options;
+    ngx_client_http_request_t             req;
+    ngx_client_http_post_request_t        post;
+    ngx_stream_lua_http_client_ctx_t     *ctx;
+    ngx_stream_lua_http_client_stream_t  *stream;
+
+    lctx = ngx_stream_lua_http_client_context(r, err, errlen);
+    if (lctx == NULL) {
+        return NGX_ERROR;
+    }
+
+    ngx_memzero(&req, sizeof(ngx_client_http_request_t));
+
+    headers.elts = request->headers;
+    headers.nelts = request->nheaders;
+
+    req.server_name = request->server.len ? &request->server : NULL;
+    req.method = request->method;
+    req.url = request->url;
+    req.headers = &headers;
+    req.body = request->body;
+
+    stream = NULL;
+
+    if (request->stream) {
+        stream = ngx_calloc(sizeof(ngx_stream_lua_http_client_stream_t),
+                            r->connection->log);
+        if (stream == NULL) {
+            goto nomem;
+        }
+
+        ctx = &stream->ctx;
+        stream->event.data = ctx;
+        stream->event.handler = ngx_stream_lua_http_client_notify;
+        stream->event.log = r->connection->log;
+
+    } else {
+        ctx = ngx_calloc(sizeof(ngx_stream_lua_http_client_ctx_t),
+                         r->connection->log);
+        if (ctx == NULL) {
+            goto nomem;
+        }
+    }
+
+    ctx->response_limit = request->response_limit;
+    ctx->request = r;
+
+    if (stream) {
+        options.notify = &stream->event;
+        options.check_size = ngx_stream_lua_http_client_check_size;
+        options.data = ctx;
+        options.request_body_streaming = request->request_body_streaming;
+
+        rc = ngx_client_http_create_streaming_request((ngx_cycle_t *) ngx_cycle,
+                                                      r->connection->log, &req,
+                                                      &ctx->client, &options);
+
+    } else {
+        ngx_memzero(&post, sizeof(ngx_client_http_post_request_t));
+        post.handler = ngx_stream_lua_http_client_complete;
+        post.check_size = ngx_stream_lua_http_client_check_size;
+        post.data = ctx;
+
+        rc = ngx_client_http_create_request((ngx_cycle_t *) ngx_cycle,
+                                            r->connection->log, &req,
+                                            &ctx->client, &post);
+    }
+
+    if (rc != NGX_OK) {
+        ngx_free(ctx);
+
+        if (rc == NGX_DECLINED) {
+            *errlen = ngx_snprintf(err, *errlen, "unknown client server \"%V\"",
+                                   &request->server) - err;
+
+        } else {
+            *errlen = ngx_snprintf(err, *errlen,
+                                   "failed to create HTTP request") - err;
+        }
+
+        return NGX_ERROR;
+    }
+
+    *result = &ctx->result;
+
+    if (stream) {
+        stream->cleanup = ngx_stream_lua_cleanup_add(r, 0);
+        if (stream->cleanup == NULL) {
+            ngx_client_http_close_request(ctx->client);
+            ngx_free(ctx);
+            goto nomem;
+        }
+
+        stream->cleanup->handler = ngx_stream_lua_http_client_stream_cleanup;
+        stream->cleanup->data = stream;
+        return NGX_OK;
+    }
+
+    coctx = lctx->cur_co_ctx;
+    ngx_stream_lua_cleanup_pending_operation(coctx);
+    coctx->cleanup = ngx_stream_lua_http_client_cancel;
+    coctx->data = ctx;
+
+    ctx->coctx = coctx;
+    return NGX_AGAIN;
+
+nomem:
+
+    *errlen = ngx_snprintf(err, *errlen, "no memory") - err;
+    return NGX_ERROR;
+}
+
+
+void
+ngx_stream_lua_ffi_http_client_done(ngx_stream_lua_http_client_result_t *result)
+{
+    ngx_stream_lua_http_client_ctx_t *ctx;
+
+    ctx = (ngx_stream_lua_http_client_ctx_t *) result;
+    ngx_stream_lua_cleanup_pending_operation(ctx->coctx);
+}
+
+
+int
+ngx_stream_lua_ffi_http_client_get_response_headers(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_result_t *result)
+{
+    ngx_int_t                          rc;
+    ngx_client_http_response_t        *response;
+    ngx_stream_lua_http_client_ctx_t  *ctx;
+
+    ctx = (ngx_stream_lua_http_client_ctx_t *) result;
+    if (ctx->request != r || ctx->client == NULL) {
+        return NGX_ABORT;
+    }
+
+    rc = ngx_client_http_get_response_headers(ctx->client, &response);
+    if (rc == NGX_OK) {
+        result->status = response->status;
+        result->headers = response->headers.elts;
+        result->nheaders = response->headers.nelts;
+    }
+
+    return rc;
+}
+
+
+ssize_t
+ngx_stream_lua_ffi_http_client_read_response_body(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_result_t *result, u_char *buf, size_t size)
+{
+    ngx_stream_lua_http_client_ctx_t  *ctx;
+
+    ctx = (ngx_stream_lua_http_client_ctx_t *) result;
+
+    if (ctx->request != r || ctx->client == NULL) {
+        return NGX_ABORT;
+    }
+
+    if (ctx->coctx) {
+        return NGX_BUSY;
+    }
+
+    return ngx_client_http_read_response_body(ctx->client, buf, size);
+}
+
+
+ssize_t
+ngx_stream_lua_ffi_http_client_write_request_body(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_result_t *result, const u_char *buf,
+    size_t size)
+{
+    ngx_stream_lua_http_client_ctx_t  *ctx;
+
+    ctx = (ngx_stream_lua_http_client_ctx_t *) result;
+
+    if (ctx->request != r || ctx->client == NULL) {
+        return NGX_ABORT;
+    }
+
+    return ngx_client_http_write_request_body(ctx->client, buf, size);
+}
+
+
+int
+ngx_stream_lua_ffi_http_client_wait(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_http_client_result_t *result, u_char *err, size_t *errlen)
+{
+    ngx_stream_lua_ctx_t              *lctx;
+    ngx_stream_lua_co_ctx_t           *coctx;
+    ngx_stream_lua_http_client_ctx_t  *ctx;
+
+    ctx = (ngx_stream_lua_http_client_ctx_t *) result;
+
+    if (ctx->request != r || ctx->client == NULL || ctx->coctx) {
+        *errlen = ngx_snprintf(err, *errlen,
+                               "HTTP stream is closed or busy") - err;
+        return NGX_ERROR;
+    }
+
+    lctx = ngx_stream_lua_http_client_context(r, err, errlen);
+    if (lctx == NULL) {
+        return NGX_ERROR;
+    }
+
+    coctx = lctx->cur_co_ctx;
+    ngx_stream_lua_cleanup_pending_operation(coctx);
+    coctx->cleanup = ngx_stream_lua_http_client_wait_cleanup;
+    coctx->data = ctx;
+    ctx->coctx = coctx;
+
+    return NGX_AGAIN;
+}
+
+
+static void
+ngx_stream_lua_http_client_notify(ngx_event_t *ev)
+{
+    ngx_stream_lua_co_ctx_t           *coctx;
+    ngx_stream_lua_http_client_ctx_t  *ctx;
+
+    ctx = ev->data;
+    coctx = ctx->coctx;
+    if (coctx == NULL) {
+        return;
+    }
+
+    ctx->coctx = NULL;
+    coctx->cleanup = NULL;
+    coctx->data = NULL;
+
+    ngx_stream_lua_http_client_handler(ctx->request, coctx);
+}
+
+
+static void
+ngx_stream_lua_http_client_wait_cleanup(void *data)
+{
+    ngx_stream_lua_co_ctx_t  *coctx = data;
+
+    ngx_stream_lua_http_client_stream_cleanup(coctx->data);
+}
+
+
+static void
+ngx_stream_lua_http_client_stream_cleanup(void *data)
+{
+    ngx_stream_lua_http_client_stream_t  *stream = data;
+
+    if (stream->cleanup) {
+        stream->cleanup->handler = NULL;
+        ngx_stream_lua_cleanup_free(stream->ctx.request,
+                                    &stream->cleanup->handler);
+        stream->cleanup = NULL;
+    }
+
+    if (stream->ctx.coctx) {
+        stream->ctx.coctx->cleanup = NULL;
+        stream->ctx.coctx->data = NULL;
+        stream->ctx.coctx = NULL;
+    }
+
+    if (stream->event.posted) {
+        ngx_delete_posted_event(&stream->event);
+    }
+
+    if (stream->ctx.client) {
+        ngx_client_http_close_request(stream->ctx.client);
+        stream->ctx.client = NULL;
+    }
+
+    stream->ctx.request = NULL;
+}
+
+
+void
+ngx_stream_lua_ffi_http_client_close(
+    ngx_stream_lua_http_client_result_t *result)
+{
+    ngx_stream_lua_http_client_stream_t  *stream;
+
+    stream = (ngx_stream_lua_http_client_stream_t *) result;
+
+    if (stream->ctx.coctx && stream->ctx.client) {
+        ngx_client_http_close_request(stream->ctx.client);
+        stream->ctx.client = NULL;
+        ngx_post_event(&stream->event, &ngx_posted_events);
+        return;
+    }
+
+    ngx_stream_lua_http_client_stream_cleanup(stream);
+}
+
+
+void
+ngx_stream_lua_ffi_http_client_release(
+    ngx_stream_lua_http_client_result_t *result)
+{
+    ngx_stream_lua_http_client_stream_cleanup(result);
+    ngx_free(result);
+}
+
+
+static void
+ngx_stream_lua_http_client_cancel(void *data)
+{
+    ngx_stream_lua_co_ctx_t   *coctx = data;
+
+    ngx_stream_lua_http_client_ctx_t *ctx;
+
+    ctx = coctx->data;
+    coctx->data = NULL;
+
+    if (ctx->client) {
+        ngx_client_http_close_request(ctx->client);
+    }
+
+    ngx_free(ctx);
+}
+
+
+static ngx_int_t
+ngx_stream_lua_http_client_check_size(void *data, size_t header_size,
+    uint64_t body_size)
+{
+    ngx_stream_lua_http_client_ctx_t  *ctx = data;
+
+    if (header_size > 64 * 1024
+        || (ctx->response_limit && body_size > ctx->response_limit))
+    {
+        return NGX_CLIENT_HTTP_TOO_LARGE;
+    }
+
+    return NGX_OK;
+}
+
+
+static void
+ngx_stream_lua_http_client_complete(ngx_client_http_response_t *response,
+    void *data, ngx_int_t rc)
+{
+    ngx_stream_lua_http_client_ctx_t  *ctx = data;
+
+    ctx->client = NULL;
+
+    if (rc == NGX_OK) {
+        ctx->result.status = response->status;
+        ctx->result.body = response->body;
+        ctx->result.headers = response->headers.elts;
+        ctx->result.nheaders = response->headers.nelts;
+
+    } else {
+        switch (rc) {
+
+        case NGX_CLIENT_HTTP_TIMEDOUT:
+            ctx->result.error = "timeout";
+            break;
+
+        case NGX_CLIENT_HTTP_TOO_LARGE:
+            ctx->result.error = "HTTP response exceeds maximum size";
+            break;
+
+        default:
+            ctx->result.error = "HTTP request failed";
+        }
+    }
+
+    /* The client posts completion after closing its internal HTTP request. */
+    ngx_stream_lua_http_client_handler(ctx->request, ctx->coctx);
+}
+
+
+static void
+ngx_stream_lua_http_client_handler(ngx_stream_lua_request_t *r,
+    ngx_stream_lua_co_ctx_t *coctx)
+{
+    ngx_stream_lua_ctx_t      *lctx;
+
+    lctx = ngx_stream_lua_get_module_ctx(r, ngx_stream_lua_module);
+    if (lctx == NULL) {
+        ngx_stream_lua_cleanup_pending_operation(coctx);
+        return;
+    }
+
+    lctx->cur_co_ctx = coctx;
+
+    if (lctx->entered_content_phase) {
+        (void) ngx_stream_lua_http_client_resume(r);
+
+    } else {
+        lctx->resume_handler = ngx_stream_lua_http_client_resume;
+        ngx_stream_lua_core_run_phases(r);
+    }
+}
+
+
+static ngx_int_t
+ngx_stream_lua_http_client_resume(ngx_stream_lua_request_t *r)
+{
+    lua_State             *vm;
+    ngx_int_t              rc;
+    ngx_uint_t             nreqs;
+    ngx_connection_t      *c;
+    ngx_stream_lua_ctx_t  *ctx;
+
+    ctx = ngx_stream_lua_get_module_ctx(r, ngx_stream_lua_module);
+    ctx->resume_handler = ngx_stream_lua_wev_handler;
+
+    c = r->connection;
+    vm = ngx_stream_lua_get_lua_vm(r, ctx);
+    nreqs = c->requests;
+
+    rc = ngx_stream_lua_run_thread(vm, r, ctx, 0);
+
+    if (rc == NGX_AGAIN) {
+        return ngx_stream_lua_run_posted_threads(c, vm, r, ctx, nreqs);
+    }
+
+    if (rc == NGX_DONE) {
+        ngx_stream_lua_finalize_request(r, NGX_DONE);
+        return ngx_stream_lua_run_posted_threads(c, vm, r, ctx, nreqs);
+    }
+
+    if (ctx->entered_content_phase) {
+        ngx_stream_lua_finalize_request(r, rc);
+        return NGX_DONE;
+    }
+
+    return rc;
+}
+
+#endif
diff --git a/src/ngx_stream_lua_module.c b/src/ngx_stream_lua_module.c
index 1cbb3a6..5808a0b 100755
--- a/src/ngx_stream_lua_module.c
+++ b/src/ngx_stream_lua_module.c
@@ -607,6 +607,11 @@ ngx_stream_lua_init(ngx_conf_t *cf)
     ngx_stream_core_main_conf_t        *cmcf;
 
 
+#if (NGX_EXT && NGX_CLIENT)
+    if (ngx_client_http_require(cf->cycle) != NGX_OK) {
+        return NGX_ERROR;
+    }
+#endif
     if (ngx_process == NGX_PROCESS_SIGNALLER || ngx_test_config) {
         return NGX_OK;
     }
