+        pcv->cookie.regex = ngx_http_regex_compile(cf, &rc);
+        if (pcv->cookie.regex == NULL) {
+            return NGX_CONF_ERROR;
+        }
+
+        pcv->regex = 1;
+#else
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
