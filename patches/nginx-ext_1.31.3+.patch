+ngx_int_t
+ngx_http_get_request_id(ngx_http_request_t *r, ngx_str_t *id)
+{
+    ngx_http_core_loc_conf_t   *clcf;
+
+    u_char                     *buf;
+    u_char                     *p;
+    ngx_time_t                 *tp;
+    ngx_list_part_t            *part;
+    ngx_table_elt_t            *header;
+    ngx_uint_t                  i;
+    uint64_t                    random_bytes[2];
+
+    static uint64_t             counter, key[2];
+
+    if (r->request_id.len > 0) {
+        *id = r->request_id;
+        return NGX_OK;
+    }
+
+    if (r != r->main && ngx_http_get_request_id(r->main, id) == NGX_OK) {
+        r->request_id = *id;
+        return NGX_OK;
+    }
+
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+
+    /* request id from header */
+    if (clcf->request_id_header.len > 0) {
+        part = &r->headers_in.headers.part;
+        header = part->elts;
+
+        for (i = 0; /* void */; i++) {
+
+            if (i >= part->nelts) {
+                if (part->next == NULL) {
+                    break;
+                }
+
+                part = part->next;
+                header = part->elts;
+                i = 0;
+            }
+
+            if (header[i].key.len == clcf->request_id_header.len
+                && ngx_strncasecmp(header[i].key.data,
+                                   clcf->request_id_header.data,
+                                   clcf->request_id_header.len) == 0
+                && header[i].value.len > 0)
+            {
+                r->request_id = header[i].value;
+                *id = r->request_id;
+                return NGX_OK;
+            }
+        }
+    }
+
+    if (clcf->request_id_algorithm == NGX_HTTP_REQUEST_ID_HEXID) {
+        buf = ngx_pnalloc(r->pool, 32);
+        if (buf == NULL) {
+            return NGX_ERROR;
+        }
+
+        r->request_id.len = 32;
+        r->request_id.data = buf;
+        *id = r->request_id;
+
+        if (counter == 0) {
+#if (NGX_OPENSSL)
+            if (RAND_bytes((u_char *) key, 16) != 1)
+#endif
+            {
+                key[0] = ((uint64_t) ngx_random() << 32)
+                         | (uint32_t) ngx_random();
+                key[1] = ((uint64_t) ngx_random() << 32)
+                         | (uint32_t) ngx_random();
+                key[0] ^= (uint64_t) ngx_pid << 16;
+                key[1] ^= (uint64_t) ngx_time();
+            }
+        }
+
+        counter++;
+        random_bytes[0] = ngx_siphash(key[0], key[1],
+                                      (u_char *) &counter, 8);
+
+        counter++;
+        random_bytes[1] = ngx_siphash(key[0], key[1],
+                                      (u_char *) &counter, 8);
+
+        ngx_hex_dump(buf, (u_char *) random_bytes, 16);
+
+        return NGX_OK;
+    }
+
+
+    /* NGX_HTTP_REQUEST_ID_TRACEID */
+    buf = ngx_pnalloc(r->pool,
+                      NGX_TIME_T_LEN + ngx_cycle->hostname.len
+                      + NGX_INT64_LEN + NGX_ATOMIC_T_LEN
+                      + NGX_INT_T_LEN + 4);
+    if (buf == NULL) {
+        return NGX_ERROR;
+    }
+
+    tp = ngx_timeofday();
+    p = ngx_sprintf(buf, "%xT_%*s_%P-%uA-%ui",
+                    tp->sec, ngx_cycle->hostname.len, ngx_cycle->hostname.data,
+                    ngx_pid, r->connection->number, r->connection->requests);
+
+    r->request_id.len = p - buf;
+    r->request_id.data = buf;
+    *id = r->request_id;
+
+    return NGX_OK;
+}
+
+#endif
