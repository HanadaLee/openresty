diff --git a/config b/config
--- a/config
+++ b/config
@@ -256,6 +256,7 @@
                 $ngx_addon_dir/src/ngx_stream_lua_string.c \
                 $ngx_addon_dir/src/ngx_stream_lua_control.c \
                 $ngx_addon_dir/src/ngx_stream_lua_sleep.c \
