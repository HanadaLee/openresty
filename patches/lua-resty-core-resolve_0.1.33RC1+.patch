diff --git a/lib/resty/core/resolver.lua b/lib/resty/core/resolver.lua
--- /dev/null
+++ b/lib/resty/core/resolver.lua
@@ -0,0 +1,136 @@
+local base = require "resty.core.base"
+base.allows_subsystem("http", "stream")
+
+local ffi = require "ffi"
+local new_tab = require "table.new"
+local C = ffi.C
+local ffi_str = ffi.string
+local FFI_AGAIN = base.FFI_AGAIN
+local FFI_OK = base.FFI_OK
+local get_request = base.get_request
+local get_size_ptr = base.get_size_ptr
+local get_string_buf = base.get_string_buf
+local co_yield = coroutine._yield
+local error = error
+local tonumber = tonumber
+local type = type
+
+
+local ffi_resolve
+local ffi_resolve_done
+local result_ptr
+
+if ngx.config.subsystem == "http" then
+    ffi.cdef[[
+        typedef struct {
+            unsigned char                *data;
+            size_t                        len;
+            int                           family;
+        } ngx_http_lua_resolver_addr_t;
+
+        typedef struct {
+            ngx_http_lua_resolver_addr_t *addrs;
+            const char                   *error;
+            size_t                        naddrs;
+            ngx_str_t                     name;
+        } ngx_http_lua_resolver_result_t;
+
+        int ngx_http_lua_ffi_resolve(ngx_http_request_t *r,
+            const unsigned char *host, size_t len, int family,
+            ngx_http_lua_resolver_result_t **result, unsigned char *err,
+            size_t *errlen);
+        void ngx_http_lua_ffi_resolve_done(
+            ngx_http_lua_resolver_result_t *result);
+    ]]
+
+    ffi_resolve = C.ngx_http_lua_ffi_resolve
+    ffi_resolve_done = C.ngx_http_lua_ffi_resolve_done
+    result_ptr = ffi.new("ngx_http_lua_resolver_result_t *[1]")
+
+else
+    ffi.cdef[[
+        typedef struct {
+            unsigned char                  *data;
+            size_t                          len;
+            int                             family;
+        } ngx_stream_lua_resolver_addr_t;
+
+        typedef struct {
+            ngx_stream_lua_resolver_addr_t *addrs;
+            const char                     *error;
+            size_t                          naddrs;
+            ngx_str_t                       name;
+        } ngx_stream_lua_resolver_result_t;
+
+        int ngx_stream_lua_ffi_resolve(ngx_stream_lua_request_t *r,
+            const unsigned char *host, size_t len, int family,
+            ngx_stream_lua_resolver_result_t **result, unsigned char *err,
+            size_t *errlen);
+        void ngx_stream_lua_ffi_resolve_done(
+            ngx_stream_lua_resolver_result_t *result);
+    ]]
+
+    ffi_resolve = C.ngx_stream_lua_ffi_resolve
+    ffi_resolve_done = C.ngx_stream_lua_ffi_resolve_done
+    result_ptr = ffi.new("ngx_stream_lua_resolver_result_t *[1]")
+end
+
+
+local RESOLVE_PTR = -1
+local family_ids = { both = 0, ipv4 = 4, ipv6 = 6, ptr = RESOLVE_PTR }
+local ERR_BUF_SIZE = 128
+
+
+function ngx.resolve(host, family)
+    if type(host) ~= "string" then
+        error("hostname must be a string", 2)
+    end
+
+    local family_id = family == nil and 0 or family_ids[family]
+    if family_id == nil then
+        error("family must be 'ipv4', 'ipv6', 'both', or 'ptr'", 2)
+    end
+
+    local r = get_request()
+    if not r then
+        error("no request found", 2)
+    end
+
+    local errbuf = get_string_buf(ERR_BUF_SIZE)
+    local errlen = get_size_ptr()
+    errlen[0] = ERR_BUF_SIZE
+
+    local rc = ffi_resolve(r, host, #host, family_id, result_ptr,
+                           errbuf, errlen)
+    if rc ~= FFI_OK and rc ~= FFI_AGAIN then
+        return nil, ffi_str(errbuf, errlen[0])
+    end
+
+    local result = result_ptr[0]
+    if rc == FFI_AGAIN then
+        co_yield()
+    end
+
+    if result.error ~= nil then
+        local err = ffi_str(result.error)
+        ffi_resolve_done(result)
+        return nil, err
+    end
+
+    if family_id == RESOLVE_PTR then
+        local name = ffi_str(result.name.data, result.name.len)
+        ffi_resolve_done(result)
+        return name
+    end
+
+    local naddrs = tonumber(result.naddrs)
+    local addrs = new_tab(naddrs, 0)
+    for i = 0, naddrs - 1 do
+        local addr = result.addrs[i]
+        addrs[i + 1] = { addr = ffi_str(addr.data, addr.len),
+                         type = addr.family }
+    end
+
+    ffi_resolve_done(result)
+    return addrs
+end
