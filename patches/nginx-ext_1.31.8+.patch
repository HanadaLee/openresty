+static ngx_str_t *
+ngx_http_upstream_strerror(ngx_http_upstream_error_e code)
+{
+    if (code <= NGX_HTTP_UPSTREAM_ERR_INTERNAL_ERROR) {
+        return &ngx_http_upstream_errors[code];
+    }
+
+    return &ngx_http_upstream_errors[NGX_HTTP_UPSTREAM_ERR_NONE];
+}
