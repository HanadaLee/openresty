+        if (user->data == NULL) {
+            return NGX_CONF_ERROR;
+        }
+
+        ngx_memcpy(user->data, value[1].data, len);
+        user->data[len] = '\0';
+
+    } else {
+        *user = value[1];
+    }
+
+    return NGX_CONF_OK;
+}
