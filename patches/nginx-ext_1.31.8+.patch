+            && ngx_http_regex_exec(r, hc->ssl_servername_regex,
+                                   hc->ssl_servername) != NGX_OK)
+        {
+            ngx_http_free_request(r, 0);
+            c->log->action = action;
+            c->destroyed = 0;
+            goto error;
+        }
+#endif
+
+#if (NGX_EXPR)
+        reject = ngx_http_get_expr_flag_value(r, sscf->reject_handshake);
