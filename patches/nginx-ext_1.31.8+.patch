+                                   clcf->request_id_header.len) == 0)
+            {
+                if (header[i].value.len == 0 || header[i].value.len > 1024) {
+                    break;
+                }
+
+                for (j = 0; j < header[i].value.len; j++) {
+                    ch = header[i].value.data[j];
+
+                    if ((ch >= 'a' && ch <= 'z')
+                        || (ch >= 'A' && ch <= 'Z')
+                        || (ch >= '0' && ch <= '9')
+                        || ch == '.' || ch == '-' || ch == '_')
+                    {
